<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>User Management System</title>
    <!-- Include Bootstrap 5 CSS for responsive design and styling -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>

<!-- Apply a dark background and light text color to the entire body -->
<body class="bg-dark text-light">

  <!-- Navigation bar -->
  <nav class="navbar navbar-expand-lg shadow-sm mb-4 bg" style="background-color: #32434f;" data-bs-theme="light">
    <div class="container">
      
      <!-- Navbar brand linking to the Users list page -->
      <a class="navbar-brand fw-bold text-light fs-3" href="/users">
        <i class="bi bi-people-fill me-2"></i>User Management
      </a>
      
      <!-- Toggle button for mobile view -->
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
        <span class="navbar-toggler-icon"></span>
      </button>
      
      <!-- Navbar links -->
      <div class="collapse navbar-collapse" id="navbarNav">
        <ul class="navbar-nav ms-auto align-items-center">
          
          <!-- Link to Users list -->
          <li class="nav-item">
            <a class="nav-link text-info fw-semibold fs-4" href="/users">Users</a>
          </li>

          <!-- Button to navigate to Add User form -->
          <li class="nav-item">
            <a class="btn btn-outline-light btn-sm rounded-pill ms-2 px-3 fw-bold" href="/users/new">
              <i class="bi bi-person-plus-fill me-1"></i>Add User
            </a>
          </li>
        </ul>
      </div>
    </div>
  </nav>

  <!-- Main content container where dynamic views will be rendered -->
  <div class="container">
    {{{body}}} <!-- Placeholder for the page-specific Handlebars content -->
  </div>

  <!-- Script for Bootstrap form validation: prevents form submission if fields are invalid and applies visual feedback -->
  <script>
    
    (function () {
      'use strict'
      // Select all forms that need validation
      const forms = document.querySelectorAll('.needs-validation')

      // Add submit event listener to each form
      Array.from(forms).forEach(function (form) {
        form.addEventListener('submit', function (event) {
          // Prevent submission if form is invalid
          if (!form.checkValidity()) {
            event.preventDefault()  
            event.stopPropagation()
          }

          // Add validation styling
          form.classList.add('was-validated') 
        }, false)
      })
    })()
  </script>

  <!-- Include Bootstrap 5 JS bundle for interactive components -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
