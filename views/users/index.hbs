<div class="container my-4">
  <h2 class="text-center mb-4">Users List</h2>

  <div class="d-flex justify-content-start mb-3">
    <a href="/users/new" class="btn btn-primary">Add New User</a>
  </div>

  <div class="table-responsive">
    <table class="table table-striped table-bordered table-hover align-middle table-sm text-nowrap small mb-0">
      <thead class="table-dark text-center">
        <tr>
          <th>First Name</th>
          <th>Last Name</th>
          <th>Date of Birth</th>
          <th>City</th>
          <th>Postal Code</th>
          <th>Country</th>
          <th>Phone</th>
          <th>Email</th>
          <th>User Notes</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody class="text-center">
        {{#each users}}
        <tr>
          <td>{{this.firstName}}</td>
          <td>{{this.lastName}}</td>
          <td>{{this.dateOfBirth}}</td>
          <td>{{this.city}}</td>
          <td>{{this.postalCode}}</td>
          <td>{{this.country}}</td>
          <td>{{this.phoneNumber}}</td>
          <td>{{this.email}}</td>
          <td class="text-wrap text-break" style="max-width: 250px;">{{this.userNotes}}</td>
          <td>
            <a href="/users/{{this._id}}/edit" class="btn btn-warning btn-sm me-1">Edit</a>
            <form action="/users/{{this._id}}?_method=DELETE" method="POST" class="d-inline">
              <button type="submit" class="btn btn-danger btn-sm" onclick="return confirm('Are you sure you want to delete this user?');">Delete</button>
            </form>
          </td>
        </tr>
        {{/each}}
      </tbody>
    </table>
  </div>
</div>
