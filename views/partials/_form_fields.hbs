<p>
  <label>First Name</label>
  <input class="w3-input" type="text" name="firstName" value="{{user.firstName}}" required>
</p>
<p>
  <label>Last Name</label>
  <input class="w3-input" type="text" name="lastName" value="{{user.lastName}}" required>
</p>
<p>
  <label>Date of Birth</label>
  <input class="w3-input" type="date" name="dateOfBirth" value="{{user.dateOfBirth}}">
</p>
<p>
  <label>Address 1</label>
  <input class="w3-input" type="text" name="address1" value="{{user.address1}}">
</p>
<p>
  <label>Address 2</label>
  <input class="w3-input" type="text" name="address2" value="{{user.address2}}">
</p>
<p>
  <label>City</label>
  <input class="w3-input" type="text" name="city" value="{{user.city}}">
</p>
<p>
  <label>Postal Code</label>
  <input class="w3-input" type="text" name="postalCode" value="{{user.postalCode}}">
</p>
<p>
  <label>Country</label>
  <input class="w3-input" type="text" name="country" value="{{user.country}}">
</p>
<p>
  <label>Phone Number</label>
  <input class="w3-input" type="text" name="phoneNumber" value="{{user.phoneNumber}}">
</p>
<p>
  <label>Email</label>
  <input class="w3-input" type="email" name="email" value="{{user.email}}">
</p>
<p>
  <label>User Notes</label>
  <textarea class="w3-input" name="userNotes">{{user.userNotes}}</textarea>
</p>