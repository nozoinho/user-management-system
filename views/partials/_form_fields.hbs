<!-- First Row: First Name, Last Name, Date of Birth -->
  <div class="row gx-3 mb-3">
    <div class="col-md-4">
      <label for="firstName" class="form-label fw-semibold {{#if user._id}}text-warning{{else}}text-info{{/if}}">
        First Name
      </label>
      <input type="text" class="form-control bg-dark text-light rounded" 
             id="firstName" name="firstName" value="{{user.firstName}}" pattern="[A-Za-z\s'-]+" required>
      <div class="invalid-feedback">
        Please enter a valid first name.
      </div>
    </div>
    <div class="col-md-4">
      <label for="lastName" class="form-label fw-semibold {{#if user._id}}text-warning{{else}}text-info{{/if}}">
        Last Name
      </label>
      <input type="text" class="form-control bg-dark text-light rounded" 
             id="lastName" name="lastName" value="{{user.lastName}}" pattern="[A-Za-z\s'-]+" required>
      <div class="invalid-feedback">
        Please enter a valid last name.
      </div>
    </div>
    <div class="col-md-4">
      <label for="dateOfBirth" class="form-label fw-semibold {{#if user._id}}text-warning{{else}}text-info{{/if}}">
        Date of Birth
      </label>
      <input type="date" class="form-control {{#if user._id}}bg-warning text-dark fw-bold{{else}}bg-info text-dark fw-bold{{/if}} rounded ps-4"
             id="dateOfBirth" name="dateOfBirth" value="{{user.dateOfBirth}}" required>
      <div class="invalid-feedback">
        Please enter a valid date of birth.
      </div>
    </div>
  </div>

  <!-- Second Row: Address 1, Address 2 -->
  <div class="row gx-3 mb-3">
    <div class="col-md-6">
      <label for="address1" class="form-label fw-semibold {{#if user._id}}text-warning{{else}}text-info{{/if}}">
        Address 1
      </label>
      <input type="text" class="form-control bg-dark text-light rounded" 
             id="address1" name="address1" value="{{user.address1}}" required>
      <div class="invalid-feedback">
        Please enter an address.
      </div>
    </div>
    <div class="col-md-6">
      <label for="address2" class="form-label fw-semibold {{#if user._id}}text-warning{{else}}text-info{{/if}}">
        Address 2
      </label>
      <input type="text" class="form-control bg-dark text-light rounded" 
             id="address2" name="address2" value="{{user.address2}}">
    </div>
  </div>

  <!-- Third Row: City, Postal Code, Country -->
  <div class="row gx-3 mb-3">
    <div class="col-md-4">
      <label for="city" class="form-label fw-semibold {{#if user._id}}text-warning{{else}}text-info{{/if}}">
        City
      </label>
      <input type="text" class="form-control bg-dark text-light rounded" 
             id="city" name="city" value="{{user.city}}" pattern="[A-Za-z\s'-]+" required>
      <div class="invalid-feedback">
        Please enter a valid city.
      </div>
    </div>
    <div class="col-md-4">
      <label for="postalCode" class="form-label fw-semibold {{#if user._id}}text-warning{{else}}text-info{{/if}}">
        Postal Code
      </label>
      <input type="text" class="form-control bg-dark text-light rounded" 
             id="postalCode" name="postalCode" value="{{user.postalCode}}" pattern="[A-Za-z0-9 ]{3,10}" required>
      <div class="invalid-feedback">
        Please enter a valid postal code.
      </div>
    </div>
    <div class="col-md-4">
      <label for="country" class="form-label fw-semibold {{#if user._id}}text-warning{{else}}text-info{{/if}}">
        Country
      </label>
      <select class="form-select {{#if user._id}}bg-warning-subtle text-dark fw-bold{{else}}bg-info-subtle text-dark fw-bold{{/if}} rounded" 
              id="country" name="country" required>
        <option value="" disabled {{#unless user.country}}selected{{/unless}}>Select a country</option>
        <option value="Canada" {{#if (eq user.country "Canada")}}selected{{/if}}>Canada</option>
        <option value="United States" {{#if (eq user.country "United States")}}selected{{/if}}>United States</option>
        <option value="Mexico" {{#if (eq user.country "Mexico")}}selected{{/if}}>Mexico</option>
        <option value="United Kingdom" {{#if (eq user.country "United Kingdom")}}selected{{/if}}>United Kingdom</option>
        <option value="Germany" {{#if (eq user.country "Germany")}}selected{{/if}}>Germany</option>
        <option value="France" {{#if (eq user.country "France")}}selected{{/if}}>France</option>
        <option value="Italy" {{#if (eq user.country "Italy")}}selected{{/if}}>Italy</option>
        <option value="Spain" {{#if (eq user.country "Spain")}}selected{{/if}}>Spain</option>
        <option value="Japan" {{#if (eq user.country "Japan")}}selected{{/if}}>Japan</option>
        <option value="China" {{#if (eq user.country "China")}}selected{{/if}}>China</option>
        <option value="India" {{#if (eq user.country "India")}}selected{{/if}}>India</option>
        <option value="Brazil" {{#if (eq user.country "Brazil")}}selected{{/if}}>Brazil</option>
        <option value="Argentina" {{#if (eq user.country "Argentina")}}selected{{/if}}>Argentina</option>
        <option value="South Africa" {{#if (eq user.country "South Africa")}}selected{{/if}}>South Africa</option>
        <option value="Australia" {{#if (eq user.country "Australia")}}selected{{/if}}>Australia</option>
        <option value="New Zealand" {{#if (eq user.country "New Zealand")}}selected{{/if}}>New Zealand</option>
        <option value="Netherlands" {{#if (eq user.country "Netherlands")}}selected{{/if}}>Netherlands</option>
        <option value="Sweden" {{#if (eq user.country "Sweden")}}selected{{/if}}>Sweden</option>
        <option value="Norway" {{#if (eq user.country "Norway")}}selected{{/if}}>Norway</option>
        <option value="Switzerland" {{#if (eq user.country "Switzerland")}}selected{{/if}}>Switzerland</option>
      </select>
      <div class="invalid-feedback">
        Please select a country.
      </div>
    </div>
  </div>

  <!-- Fourth Row: Phone Number, Email -->
  <div class="row gx-3 mb-3">
    <div class="col-md-4">
      <label for="phoneNumber" class="form-label fw-semibold {{#if user._id}}text-warning{{else}}text-info{{/if}}">
        Phone Number (e.g., +1 4165551234)
      </label>
      <input type="text" class="form-control bg-dark text-light rounded {{#if phoneError}}is-invalid{{/if}}" 
             id="phoneNumber" name="phoneNumber" value="{{user.phoneNumber}}" pattern="^\+\d{1,3}\s\d{4,14}$" required>
      {{#if phoneError}}
        <div class="invalid-feedback">
          {{phoneError}}
        </div>
      {{else}}
        <div class="invalid-feedback">
          Please enter a valid phone number with country code
        </div>
      {{/if}}
    </div>
    <div class="col-md-8">
      <label for="email" class="form-label fw-semibold {{#if user._id}}text-warning{{else}}text-info{{/if}}">
        Email
      </label>
      <input type="email" class="form-control bg-dark text-light rounded {{#if emailError}}is-invalid{{/if}}" 
             id="email" name="email" value="{{user.email}}" pattern="[a-z0-9._%+-]+@[a-z0-9.-]+\.[a-z]{2,}$" required>
      {{#if emailError}}
        <div class="invalid-feedback">
          {{emailError}}
        </div>
      {{else}}
        <div class="invalid-feedback">
          Please emter a valid email
        </div>
      {{/if}}
    </div>
  </div>

  <!-- User Notes -->
  <div class="mb-3">
    <label for="userNotes" class="form-label fw-semibold {{#if user._id}}text-warning{{else}}text-info{{/if}}">
      User Notes
    </label>
    <textarea class="form-control bg-dark text-light rounded" 
              id="userNotes" name="userNotes" rows="3">{{user.userNotes}}</textarea>
  </div>

  <!-- Submit Button -->
  <div class="d-grid gap-2 col-3 mx-auto mb-4">
    <button type="submit" class="btn {{#if user._id}}btn-outline-warning{{else}}btn-outline-info{{/if}} btn-lg fw-semibold">
      <i class="bi {{#if user._id}}bi-pencil-square{{else}}bi-check2-circle{{/if}} me-2"></i>
      {{#if user._id}}Update User{{else}}Add User{{/if}}
    </button>
  </div>